// Phase 2 schema: just enough to persist businesses, agents, and tasks and
// show an activity timeline (proposal section 17, Phase 2 deliverables).
// Subtask (Phase 3, real orchestration) and Artifact (the tool-registry
// milestone's text-file-generation tool) have since shipped — see
// docs/architecture.md. AgentMessage, ToolDefinition, and
// AgentToolPermission (proposal section 13) are still deferred: a generic
// multi-tool permission system remains premature for the handful of
// concrete tools that actually exist.

generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  businesses   Business[]
}

model Business {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  industry    String?
  description String?
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agents      Agent[]
  tasks       Task[]
  events      AgentEvent[]
  artifacts   Artifact[]
}

// Lowercase to match lib/simulation/office-layout.ts's AgentRole union —
// keeps the DB and simulation layers using the same literal strings
// instead of a mapping layer between them.
enum AgentRole {
  manager
  engineer
  researcher
  designer
}

// Mirrors AGENT_STATES in lib/simulation/state-machine.ts exactly — same
// spelling/order — so the frontend state machine and the DB agree on the
// set of valid states with no mapping layer between them.
enum AgentState {
  idle
  assigned
  walking_to_workstation
  planning
  working
  using_tool
  waiting
  collaborating
  needs_approval
  completed
  failed
  paused
}

model Agent {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  role         AgentRole
  instructions String?
  active       Boolean      @default(true)
  state        AgentState   @default(idle)
  resumeState  AgentState?
  currentTask  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  events       AgentEvent[]
  subtasks     Subtask[]
  artifacts    Artifact[]
}

enum TaskStatus {
  pending
  running
  paused
  completed
  failed
  cancelled
}

model Task {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  goal        String
  status      TaskStatus   @default(pending)
  // Populated on a top-level orchestration failure (planner error, an
  // unexpected exception) once the run is detached from the request —
  // per-subtask failures already have a home in Subtask.result.
  error       String?
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  events      AgentEvent[]
  subtasks    Subtask[]
  artifacts   Artifact[]
}

// Deferred since Phase 1/2 (see this file's header comment) until real
// orchestration existed to need it — Phase 3's planner assigns one Subtask
// per relevant role, each carrying the AI-generated title/description and
// its eventual result. Reuses TaskStatus rather than a near-duplicate enum.
model Subtask {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title       String
  description String
  result      String?
  status      TaskStatus @default(pending)
  createdAt   DateTime   @default(now())
  completedAt DateTime?
}

// One append-only table backs the activity timeline for a business. Kept
// intentionally loose (a string type + a JSON payload) since the exact
// event shapes are still being worked out client-side in
// lib/simulation/state-machine.ts and will settle before Phase 3 wires
// this up to real writes.
model AgentEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type       String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// A generated deliverable from the generate_text_file tool
// (lib/ai/tools/generate-file.ts) — text-only, no blob storage needed for
// the scope this tool actually covers.
model Artifact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  filename   String
  content    String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// Pre-launch email capture on the public landing page — deliberately not
// linked to User (most rows here will never become an account) and kept
// to exactly the fields a waitlist needs, not a marketing-CRM schema.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
